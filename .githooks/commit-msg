#!/bin/sh
# Pasitos · valida el mensaje del commit con commitlint (Conventional Commits).
# Se activa con: git config core.hooksPath .githooks
if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint --edit "$1"
else
  echo "⚠️  commitlint no está instalado (corre pnpm install). No se validó el mensaje."
fi
