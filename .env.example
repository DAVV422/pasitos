# Pasitos · variables de entorno de ejemplo para desarrollo local.
# Copiar a `.env` (que no se sube) y ajustar. En producción, los valores reales
# van cifrados con sops + age (infra/secretos/, T-002).

NODE_ENV=development

# PostgreSQL local (infra/compose.dev.yml)
POSTGRES_PASSWORD=postgres-local
PASITOS_OWNER_PASSWORD=owner-local
PASITOS_APP_PASSWORD=app-local
PASITOS_SISTEMA_PASSWORD=sistema-local
PASITOS_COPIAS_PASSWORD=copias-local
POSTGRES_PORT=55432

DATABASE_URL_OWNER=postgres://pasitos_owner:owner-local@localhost:55432/pasitos
DATABASE_URL_APP=postgres://pasitos_app:app-local@localhost:55432/pasitos
DATABASE_URL_SISTEMA=postgres://pasitos_sistema:sistema-local@localhost:55432/pasitos

# API
PORT=3000
LOG_LEVEL=debug

# Sesión del equipo (HU-201). La llave cifra el secreto de TOTP y los enlaces de invitación:
# 32 bytes en base64. Genera la tuya (nunca la subas):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LLAVE_CIFRADO_DATOS=
LLAVES_CIFRADO_ANTERIORES=
PUBLIC_URL=http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Pasitos
# Cuántos proxies hay delante del API (para la IP del límite de intentos). Local: 1.
TRUST_PROXY_SALTOS=1
# Have I Been Pwned (contraseñas filtradas, k-anonimato). false en el CI y sin internet.
HIBP_ACTIVO=true

# Sentry (D58). Vacío = apagado (así queda en desarrollo).
SENTRY_DSN=
SENTRY_ENVIRONMENT=desarrollo

# Organización demo (T-010): correos del equipo que serán dueños, separados por coma.
DEMO_DUENOS=

# ── Correo (T-007a; solo el trabajador) ────────────────────────────────────────
# En desarrollo van a Mailpit (pnpm db:levantar lo levanta): http://localhost:8025. Nada sale de la computadora.
# Ver un ejemplo de cada correo: pnpm correos:vista
CORREO_ADAPTADOR=smtp
CORREO_SMTP_URL=smtp://localhost:1025
CORREO_REMITENTE=Pasitos <hola@example.com>
CORREO_SOPORTE=soporte@example.com
CORREO_TOPE_DIARIO=80
CORREO_RESERVA_SEGURIDAD=10
CORREO_ENVIOS_POR_SEGUNDO=2

# ── Stellar y sellador (solo el trabajador; HU-103) ────────────────────────────
# Red local: pnpm stellar:levantar · cuentas: pnpm stellar:cuentas --red local · WASM: pnpm contrato:instalar --red local
# mainnet no se permite en el piloto (D50).
STELLAR_RED=local
STELLAR_RPC_URL=http://127.0.0.1:8000/rpc
STELLAR_WASM_HASH=
# Archivo con la llave secreta del operador (lo crea pnpm stellar:cuentas fuera del repositorio). Nunca la llave aquí.
STELLAR_OPERADOR_LLAVE_ARCHIVO=
STELLAR_ADMIN_DIRECCION=
ANCLAJE_INTERVALO_MIN=5
ANCLAJE_LOTE_MAX=10000
# Costo de red (HU-104). Topes por transacción en stroops (1 XLM = 10 000 000): anchor y preparación del contrato.
STELLAR_COMISION_MAX_STROOPS=1000000
STELLAR_COMISION_MAX_PREPARACION_STROOPS=10000000
# Presupuesto mensual; alerta al 80 % y al 100 %. Vacío = sin alerta.
STELLAR_PRESUPUESTO_MENSUAL_STROOPS=
# Volumen de archivos: aquí va publicos/<organización>/<evento>/evidencia-stellar.json (HU-105). En el VPS, /srv/pasitos/archivos.
ARCHIVOS_DIR=.archivos
