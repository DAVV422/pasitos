# Pasitos · variables de entorno de ejemplo para desarrollo local.
# Copiar a `.env` (que no se sube) y ajustar. En producción, los valores reales
# van cifrados con sops + age (infra/secretos/, T-002).

NODE_ENV=development

# PostgreSQL local (infra/compose.dev.yml)
POSTGRES_PASSWORD=postgres-local
PASITOS_OWNER_PASSWORD=owner-local
PASITOS_APP_PASSWORD=app-local
PASITOS_SISTEMA_PASSWORD=sistema-local
PASITOS_COPIAS_PASSWORD=copias-local
POSTGRES_PORT=55432

DATABASE_URL_OWNER=postgres://pasitos_owner:owner-local@localhost:55432/pasitos
DATABASE_URL_APP=postgres://pasitos_app:app-local@localhost:55432/pasitos
DATABASE_URL_SISTEMA=postgres://pasitos_sistema:sistema-local@localhost:55432/pasitos

# API
PORT=3000
LOG_LEVEL=debug

# Sentry (D58). Vacío = apagado (así queda en desarrollo).
SENTRY_DSN=
SENTRY_ENVIRONMENT=desarrollo

# Organización demo (T-010): correos del equipo que serán dueños, separados por coma.
DEMO_DUENOS=
