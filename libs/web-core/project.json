{
  "name": "web-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web-core/src",
  "prefix": "web",
  "projectType": "library",
  "tags": ["scope:web"],
  "targets": {
    "paquete": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web-core/ng-package.json",
        "tsConfig": "libs/web-core/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web-core/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "web-core:paquete:development"
      }
    }
  }
}
