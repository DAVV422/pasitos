{
  "name": "pasitos",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build --exclude=contrato-evento",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "pnpm format:check && pnpm lint:css && nx run-many -t lint test && pnpm build && node tools/peso.mjs",
    "db:levantar": "docker compose -f infra/compose.dev.yml --env-file .env up -d --wait",
    "db:bajar": "docker compose -f infra/compose.dev.yml --env-file .env down",
    "db:generar": "drizzle-kit generate --config libs/db/drizzle.config.ts",
    "db:migrar": "tsx --env-file=.env libs/db/src/cli/migrar.ts",
    "semilla": "tsx --env-file=.env libs/db/src/cli/semilla.ts",
    "peso": "node tools/peso.mjs",
    "lint:css": "stylelint \"libs/**/*.css\" \"apps/**/*.css\"",
    "local": "node tools/servidor-local.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
